+def _study_prefix_case():
+    import time
+    from types import SimpleNamespace
+
+    import torch
+
+    from vllm.sampling_params import SamplingParams
+    from vllm.utils.hashing import sha256
+    from vllm.v1.core.kv_cache_manager import KVCacheManager
+    from vllm.v1.core.kv_cache_utils import get_request_block_hasher, init_none_hash
+    from vllm.v1.core.sched.request_queue import FCFSRequestQueue
+    from vllm.v1.kv_cache_interface import (
+        FullAttentionSpec,
+        KVCacheConfig,
+        KVCacheGroupSpec,
+    )
+    from vllm.v1.request import Request
+
+    init_none_hash(sha256)
+    config = KVCacheConfig(
+        num_blocks=16,
+        kv_cache_tensors=[],
+        kv_cache_groups=[
+            KVCacheGroupSpec(
+                ["layer"],
+                FullAttentionSpec(
+                    block_size=16, num_kv_heads=1, head_size=1, dtype=torch.float32
+                ),
+            )
+        ],
+    )
+    manager = KVCacheManager(config, 128, 16, 16)
+    now = time.time()
+
+    def request(label, tokens, age=0.1):
+        return Request(
+            label,
+            tokens,
+            SamplingParams(max_tokens=16),
+            None,
+            arrival_time=now - age,
+            block_hasher=get_request_block_hasher(16, sha256),
+        )
+
+    seed = request("seed", list(range(65)))
+    assert manager.allocate_slots(seed, 64) is not None
+    manager.free(seed)
+    a = request("A", [999] * 65, 0.3)
+    b = request("B", list(range(32)) + [998] * 33, 0.2)
+    c = request("C", list(range(65)), 0.1)
+    queue = FCFSRequestQueue([a, b, c])
+    scheduler = SimpleNamespace(
+        waiting=queue,
+        kv_cache_manager=manager,
+        _study_trace=None,
+    )
+    return scheduler, (a, b, c)
+
+
+def test_study_prefix_policy_real_cache_and_no_pinning():
+    from vllm.v1.core.sched.study_prefix_policy import PrefixAwareWaitingPolicy
+
+    scheduler, (a, b, c) = _study_prefix_case()
+    manager = scheduler.kv_cache_manager
+    pool = manager.block_pool
+
+    def snapshot():
+        return (
+            [
+                (block.block_id, block.ref_cnt, block.block_hash)
+                for block in pool.blocks
+            ],
+            [block.block_id for block in pool.free_block_queue.get_all_free_blocks()],
+        )
+
+    before = snapshot()
+    PrefixAwareWaitingPolicy().promote(scheduler, scheduler.waiting)
+    assert list(scheduler.waiting) == [c, a, b]
+    assert snapshot() == before
+    assert manager.get_computed_blocks(c)[1] == 64
+    # Cache state changes between admissions must affect the next decision.
+    manager.reset_prefix_cache()
+    PrefixAwareWaitingPolicy().promote(scheduler, scheduler.waiting)
+    assert list(scheduler.waiting) == [a, c, b]
+
+
+def test_study_prefix_policy_fcfs_ties_and_wait_safeguard():
+    from vllm.v1.core.sched.study_prefix_policy import PrefixAwareWaitingPolicy
+
+    scheduler, (a, b, c) = _study_prefix_case()
+    policy = PrefixAwareWaitingPolicy()
+    # B and C now have the same reusable prefix. B arrived first.
+    scheduler.waiting.remove(a)
+    c.block_hashes = b.block_hashes.copy()
+    scheduler.waiting.reverse()
+    policy.promote(scheduler, scheduler.waiting)
+    assert list(scheduler.waiting) == [b, c]
+    scheduler.waiting.prepend_request(a)
+    a.arrival_time -= 3
+    policy.promote(scheduler, scheduler.waiting)
+    assert scheduler.waiting.peek_request() is a
+
+
+def test_study_prefix_policy_special_requests_and_lookahead():
+    from vllm.v1.core.sched.request_queue import FCFSRequestQueue
+    from vllm.v1.core.sched.study_prefix_policy import PrefixAwareWaitingPolicy
+    from vllm.v1.request import RequestStatus
+
+    scheduler, (a, b, c) = _study_prefix_case()
+    policy = PrefixAwareWaitingPolicy()
+    for status in (
+        RequestStatus.PREEMPTED,
+        RequestStatus.WAITING_FOR_STRUCTURED_OUTPUT_GRAMMAR,
+    ):
+        a.status = status
+        policy.promote(scheduler, scheduler.waiting)
+        assert list(scheduler.waiting) == [a, b, c]
+    a.status = RequestStatus.WAITING
+    a.num_preemptions = 1
+    policy.promote(scheduler, scheduler.waiting)
+    assert scheduler.waiting.peek_request() is a
+    a.num_preemptions = 0
+    holding_queue = FCFSRequestQueue([a, b, c])
+    policy.promote(scheduler, holding_queue)
+    assert list(holding_queue) == [a, b, c]
+    PrefixAwareWaitingPolicy(lookahead=1).promote(scheduler, scheduler.waiting)
+    assert scheduler.waiting.peek_request() is a
+
+
+def test_study_prefix_policy_opt_in_and_validation():
+    import os
+    from types import SimpleNamespace
+    from unittest.mock import patch
+
+    from vllm.v1.core.sched.request_queue import SchedulingPolicy
+    from vllm.v1.core.sched.study_prefix_policy import PrefixAwareWaitingPolicy
+
+    scheduler, _ = _study_prefix_case()
+    scheduler.kv_cache_config = scheduler.kv_cache_manager.kv_cache_config
+    scheduler.policy = SchedulingPolicy.FCFS
+    scheduler.scheduler_config = SimpleNamespace(async_scheduling=False)
+    scheduler.cache_config = SimpleNamespace(enable_prefix_caching=True)
+    scheduler.connector = None
+    scheduler.lora_config = None
+    scheduler.vllm_config = SimpleNamespace(speculative_config=None)
+    with patch.dict(os.environ, {}, clear=True):
+        assert PrefixAwareWaitingPolicy.from_environment(scheduler) is None
+        os.environ["STUDY_WAITING_POLICY"] = "prefix_first"
+        assert PrefixAwareWaitingPolicy.from_environment(scheduler) is not None
+        scheduler.scheduler_config.async_scheduling = True
+        try:
+            PrefixAwareWaitingPolicy.from_environment(scheduler)
+        except ValueError:
+            pass
+        else:
+            raise AssertionError("Unsupported asynchronous configuration accepted")
+
+
+def test_study_prefix_hybrid_keeps_fixed_head_then_reorders_tail():
+    from copy import copy
+
+    from vllm.v1.core.sched.study_prefix_policy import PrefixAwareWaitingPolicy
+
+    scheduler, (a, b, c) = _study_prefix_case()
+    d, e, f = copy(c), copy(a), copy(b)
+    d.request_id, e.request_id, f.request_id = "D", "E", "F"
+    for request in (d, e, f):
+        scheduler.waiting.add_request(request)
+    policy = PrefixAwareWaitingPolicy(fcfs_head_size=3)
+    order = []
+    for _ in range(6):
+        policy.promote(scheduler, scheduler.waiting)
+        # A failed admission would retry the same protected request.
+        if not order:
+            policy.promote(scheduler, scheduler.waiting)
+        order.append(scheduler.waiting.pop_request().request_id)
+    assert order == ["A", "B", "C", "D", "F", "E"]
+    # A drained cohort allows the next waiting batch its own protected head.
+    for request in (a, c, b):
+        scheduler.waiting.add_request(request)
+    policy.promote(scheduler, scheduler.waiting)
+    assert scheduler.waiting.peek_request() is a
+
+
+def test_study_prefix_hybrid_uses_configured_running_limit():
+    import os
+    from types import SimpleNamespace
+    from unittest.mock import patch
+
+    from vllm.v1.core.sched.request_queue import SchedulingPolicy
+    from vllm.v1.core.sched.study_prefix_policy import PrefixAwareWaitingPolicy
+
+    scheduler, _ = _study_prefix_case()
+    scheduler.kv_cache_config = scheduler.kv_cache_manager.kv_cache_config
+    scheduler.policy = SchedulingPolicy.FCFS
+    scheduler.scheduler_config = SimpleNamespace(async_scheduling=False, max_num_seqs=2)
+    scheduler.cache_config = SimpleNamespace(enable_prefix_caching=True)
+    scheduler.connector = None
+    scheduler.lora_config = None
+    scheduler.vllm_config = SimpleNamespace(speculative_config=None)
+    with patch.dict(os.environ, {"STUDY_WAITING_POLICY": "fcfs_head_prefix"}):
+        policy = PrefixAwareWaitingPolicy.from_environment(scheduler)
+    assert policy.fcfs_head_size == 2
+    assert policy.name == "fcfs_head_prefix"
