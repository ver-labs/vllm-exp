+# SPDX-License-Identifier: Apache-2.0
+"""Opt-in, local-study observation of scheduler and block-pool decisions."""
+
+import functools
+import inspect
+import json
+import os
+import sys
+import time
+from contextvars import ContextVar
+from pathlib import Path
+
+
+def install_if_enabled(scheduler):
+    """Install instance-local observers only when explicitly requested."""
+    from vllm.v1.core.study_cache_profile import install
+
+    install(scheduler)
+    if os.environ.get("VLLM_STUDY_TRACE") != "1":
+        return None
+    return SchedulerTrace(scheduler)
+
+
+class SchedulerTrace:
+    def __init__(self, scheduler):
+        self.scheduler = scheduler
+        self.pool = scheduler.kv_cache_manager.block_pool
+        self.step = 0
+        self.sequence = 0
+        self.active = ContextVar("study_request", default=None)
+        self.enabled = True
+        folder = Path(os.environ.get("VLLM_STUDY_TRACE_DIR", "results/scheduler-trace"))
+        folder.mkdir(parents=True, exist_ok=True)
+        self.path = folder / f"events-{os.getpid()}-{time.time_ns()}.jsonl"
+        self.sink = self.path.open("x", buffering=1)
+        self._install()
+        eviction = self.pool._study_eviction
+        if getattr(eviction, "name", None) == "aged_lfu":
+            eviction.on_decay = lambda **details: self.emit(
+                "CACHE_FREQUENCY_DECAY", **details
+            )
+        self.emit(
+            "TRACE_READY",
+            scheduler_source=inspect.getfile(type(scheduler)),
+            trace_file=str(self.path.resolve()),
+            max_running=scheduler.max_num_running_reqs,
+            max_active=scheduler.max_num_active_reqs,
+            token_budget_limit=scheduler.max_num_scheduled_tokens,
+            input_budget_limit=scheduler.scheduler_config.max_num_batched_tokens,
+            policy=str(scheduler.policy),
+            waiting_policy=(
+                scheduler._study_prefix_policy.name
+                if getattr(scheduler, "_study_prefix_policy", None) is not None
+                else "fcfs"
+            ),
+            eviction_policy=(
+                self.pool._study_eviction.name
+                if getattr(self.pool, "_study_eviction", None) is not None
+                else "vllm"
+            ),
+            aging_half_life_blocks=getattr(
+                self.pool._study_eviction, "half_life_blocks", None
+            ),
+            skip_continue=getattr(scheduler, "_study_skip_continue", None) is not None,
+            chunked_prefill=scheduler.scheduler_config.enable_chunked_prefill,
+            prefix_caching=scheduler.cache_config.enable_prefix_caching,
+            block_size=scheduler.block_size,
+            status_names=[status.name for status in self._statuses()],
+        )
+
+    @staticmethod
+    def _statuses():
+        from vllm.v1.request import RequestStatus
+
+        return RequestStatus
+
+    @staticmethod
+    def block(block):
+        return {
+            "id": block.block_id,
+            "refs": block.ref_cnt,
+            "cached": block.block_hash is not None,
+            "null": block.is_null,
+            "reuse_count": (
+                block.pool._study_eviction.reuse_counts[block.block_id]
+                if block.pool is not None
+                and getattr(block.pool, "_study_eviction", None) is not None
+                else None
+            ),
+        }
+
+    def request(self, request):
+        return {
+            "id": request.request_id,
+            "status": request.status.name,
+            "prompt": request.num_prompt_tokens,
+            "output": request.num_output_tokens,
+            "stored": request.num_tokens,
+            "computed": request.num_computed_tokens,
+            "in_flight": request.num_in_flight_tokens,
+            "preemptions": request.num_preemptions,
+            "blocks": [
+                [self.block(block) for block in group]
+                for group in self.scheduler.kv_cache_manager.get_blocks(
+                    request.request_id
+                ).blocks
+            ],
+        }
+
+    def free_head(self):
+        result = []
+        block = self.pool.free_block_queue.fake_free_list_head.next_free_block
+        while block is not None and block.block_id != -1 and len(result) < 16:
+            result.append(self.block(block))
+            block = block.next_free_block
+        return result
+
+    def emit(self, event, request=None, **details):
+        """Tracing failures disable the sink without changing engine results."""
+        if not self.enabled:
+            return
+        try:
+            self.sequence += 1
+            scheduler = self.scheduler
+            current = request if request is not None else self.active.get()
+            row = {
+                "seq": self.sequence,
+                "time_ns": time.time_ns(),
+                "monotonic_ns": time.monotonic_ns(),
+                "pid": os.getpid(),
+                "step": self.step,
+                "event": event,
+                "free_blocks": self.pool.get_num_free_blocks(),
+                "free_queue_head": self.free_head(),
+                "free_queue_head_limit": 16,
+                "running": [self.request(r) for r in scheduler.running],
+                "waiting": [self.request(r) for r in scheduler.waiting],
+                "kv_holding_waiting": [
+                    self.request(r) for r in scheduler.kv_holding_waiting
+                ],
+                "deferred_waiting": [
+                    self.request(r)
+                    for r in sorted(
+                        scheduler.deferred_waiting, key=lambda r: r.request_id
+                    )
+                ],
+                **details,
+            }
+            if current is not None:
+                row["request"] = self.request(current)
+            self.sink.write(json.dumps(row, default=str) + "\n")
+            if os.environ.get("VLLM_STUDY_TRACE_STDOUT", "1") == "1":
+                short = {
+                    key: value
+                    for key, value in row.items()
+                    if key
+                    not in (
+                        "running",
+                        "waiting",
+                        "kv_holding_waiting",
+                        "deferred_waiting",
+                    )
+                }
+                for queue in (
+                    "running",
+                    "waiting",
+                    "kv_holding_waiting",
+                    "deferred_waiting",
+                ):
+                    short[queue] = [r["id"] + ":" + r["status"] for r in row[queue]]
+                print("STUDY_TRACE " + json.dumps(short, default=str), flush=True)
+        except Exception as exc:
+            self._disable(exc)
+
+    def _disable(self, exc):
+        self.enabled = False
+        print(f"STUDY_TRACE_DISABLED {exc!r}", file=sys.stderr)
+
+    def capture(self, callback, default=None):
+        if not self.enabled:
+            return default
+        try:
+            return callback()
+        except Exception as exc:
+            self._disable(exc)
+            return default
+
+    def _wrap(self, target, name, event, request_arg=False, after=None):
+        original = getattr(target, name)
+        signature = inspect.signature(original)
+
+        @functools.wraps(original)
+        def observed(*args, **kwargs):
+            request = args[0] if request_arg and args else kwargs.get("request")
+            token = self.active.set(request) if request is not None else None
+            if event == "SCHEDULE":
+                self.step += 1
+            before = self.capture(lambda: self.request(request)) if request else None
+            retained_ids = (
+                self.capture(lambda: tuple(request.all_token_ids))
+                if event == "PREEMPT"
+                else None
+            )
+            arguments = self.capture(
+                lambda: signature.bind(*args, **kwargs).arguments, {}
+            )
+            extra = {}
+            for key in (
+                "num_new_tokens",
+                "num_new_computed_tokens",
+                "num_lookahead_tokens",
+                "full_sequence_must_fit",
+                "reserved_blocks",
+                "num_blocks",
+            ):
+                if key in arguments:
+                    extra[key] = arguments[key]
+            self.emit(event + "_BEGIN", request, **extra)
+            try:
+                result = original(*args, **kwargs)
+                extra = {"before": before} if before is not None else {}
+                if after is not None:
+                    extra.update(self.capture(lambda: after(result), {}))
+                if event == "PREEMPT" and retained_ids is not None:
+                    extra["token_ids_retained"] = self.capture(
+                        lambda: tuple(request.all_token_ids) == retained_ids
+                    )
+                self.emit(event + "_END", request, **extra)
+                return result
+            except Exception as exc:
+                self.emit(event + "_ERROR", request, error=repr(exc))
+                raise
+            finally:
+                if token is not None:
+                    self.active.reset(token)
+
+        setattr(target, name, observed)
+
+    def _install(self):
+        scheduler = self.scheduler
+        kv = scheduler.kv_cache_manager
+        self._wrap(
+            scheduler,
+            "schedule",
+            "SCHEDULE",
+            after=lambda output: {
+                "assigned_positions": output.num_scheduled_tokens,
+                "assigned_total": output.total_num_scheduled_tokens,
+                "kv_block_copies": [
+                    {"source": c.src_block_id, "destination": c.dst_block_id}
+                    for c in (output.kv_cache_block_copies or [])
+                ],
+                "computed_counter_phase": "optimistic scheduling bookkeeping",
+            },
+        )
+        self._wrap(scheduler, "update_from_output", "RESULT_HANDLING")
+        for name, event in (
+            ("add_request", "ENQUEUE"),
+            ("_preempt_request", "PREEMPT"),
+            ("_free_request", "FINISH"),
+            ("_update_request_with_output", "APPEND_OUTPUT"),
+        ):
+            self._wrap(scheduler, name, event, request_arg=True)
+        self._wrap(
+            scheduler,
+            "_handle_blocked_waiting_request",
+            "READINESS",
+            request_arg=True,
+            after=lambda ready: {"ready": ready},
+        )
+        self._wrap(
+            kv,
+            "get_computed_blocks",
+            "PREFIX_LOOKUP",
+            request_arg=True,
+            after=lambda result: {
+                "hit_tokens": result[1],
+                "hit_blocks": [
+                    [self.block(b) for b in group] for group in result[0].blocks
+                ],
+            },
+        )
+        self._wrap(
+            kv,
+            "allocate_slots",
+            "ALLOCATE",
+            request_arg=True,
+            after=lambda result: {
+                "success": result is not None,
+                "new_blocks": None
+                if result is None
+                else [[self.block(b) for b in group] for group in result.blocks],
+            },
+        )
+        self._wrap(kv, "free", "RELEASE_REQUEST", request_arg=True)
+        self._wrap(
+            self.pool,
+            "get_new_blocks",
+            "ALLOCATE_PHYSICAL",
+            after=lambda blocks: {"allocated": [self.block(b) for b in blocks]},
+        )
+        self._observe_refs("touch", "CLAIM_CACHED_BLOCKS", iterable=False)
+        self._observe_refs("free_blocks", "RELEASE_REFERENCES", iterable=True)
+
+        original = self.pool._maybe_evict_cached_block
+
+        @functools.wraps(original)
+        def evict(block):
+            before = self.capture(lambda: self.block(block))
+            old_hash = self.capture(
+                lambda: str(block.block_hash) if block.block_hash is not None else None
+            )
+            result = original(block)
+            if result:
+                self.emit(
+                    "EVICT_CACHED_BLOCK",
+                    before=before,
+                    after=self.capture(lambda: self.block(block)),
+                    old_hash=old_hash,
+                )
+            return result
+
+        self.pool._maybe_evict_cached_block = evict
+
+    def _observe_refs(self, name, event, iterable):
+        original = getattr(self.pool, name)
+
+        @functools.wraps(original)
+        def observed(blocks):
+            seen = []
+            before = []
+
+            def record(source):
+                for block in source:
+                    seen.append(block)
+                    before.append(self.capture(lambda block=block: self.block(block)))
+                    yield block
+
+            # Keep iterable release lazy: do not consume or reorder it early.
+            source = record(blocks) if iterable else blocks
+            if not iterable:
+                seen.extend(blocks)
+                before.extend(self.capture(lambda b=b: self.block(b)) for b in blocks)
+            result = original(source)
+            self.emit(
+                event,
+                before=before,
+                after=self.capture(lambda: [self.block(b) for b in seen], []),
+            )
+            return result
+
+        setattr(self.pool, name, observed)
