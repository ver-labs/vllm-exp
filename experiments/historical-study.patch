--- /dev/null
+++ b/vllm/v1/core/sched/study_prefix_policy.py
@@ -0,0 +1,175 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Experimental prefix-first admission for the local full-attention study."""
+
+import math
+import os
+import time
+from dataclasses import dataclass, field
+from itertools import islice
+
+from vllm.logger import init_logger
+from vllm.v1.core.sched.request_queue import SchedulingPolicy
+from vllm.v1.kv_cache_interface import FullAttentionSpec
+from vllm.v1.request import RequestStatus
+
+logger = init_logger(__name__)
+
+
+@dataclass(frozen=True)
+class PrefixAwareWaitingPolicy:
+    max_wait_s: float = 2.0
+    lookahead: int = 16
+    fcfs_head_size: int = 0
+    _cohort_ids: set[str] = field(default_factory=set, init=False, compare=False)
+    _protected_ids: set[str] = field(default_factory=set, init=False, compare=False)
+
+    @property
+    def name(self):
+        return "fcfs_head_prefix" if self.fcfs_head_size else "prefix_first"
+
+    @classmethod
+    def from_environment(cls, scheduler):
+        policy = os.environ.get("STUDY_WAITING_POLICY", "fcfs")
+        if policy == "fcfs":
+            return None
+        if policy not in ("prefix_first", "fcfs_head_prefix"):
+            raise ValueError(
+                "STUDY_WAITING_POLICY must be fcfs, prefix_first, or fcfs_head_prefix"
+            )
+        groups = scheduler.kv_cache_config.kv_cache_groups
+        if (
+            scheduler.policy != SchedulingPolicy.FCFS
+            or scheduler.scheduler_config.async_scheduling
+            or not scheduler.cache_config.enable_prefix_caching
+            or scheduler.connector is not None
+            or scheduler.lora_config is not None
+            or scheduler.vllm_config.speculative_config is not None
+            or len(groups) != 1
+            or type(groups[0].kv_cache_spec) is not FullAttentionSpec
+        ):
+            raise ValueError(
+                "prefix_first study policy requires synchronous FCFS, prefix "
+                "caching, one full-attention group, no connector/LoRA/speculation"
+            )
+        result = cls(
+            max_wait_s=float(os.environ.get("STUDY_PREFIX_MAX_WAIT_S", "2.0")),
+            lookahead=int(os.environ.get("STUDY_PREFIX_LOOKAHEAD", "16")),
+            fcfs_head_size=(
+                scheduler.scheduler_config.max_num_seqs
+                if policy == "fcfs_head_prefix"
+                else 0
+            ),
+        )
+        if not math.isfinite(result.max_wait_s) or result.max_wait_s <= 0:
+            raise ValueError("STUDY_PREFIX_MAX_WAIT_S must be finite and positive")
+        if result.lookahead < 1:
+            raise ValueError("STUDY_PREFIX_LOOKAHEAD must be positive")
+        logger.info(
+            "Study waiting policy: %s; FCFS ties; max_wait_s=%s; "
+            "lookahead=%s; protected_head=%s. "
+            "Preempted/KV-holding/blocked requests retain precedence.",
+            result.name,
+            result.max_wait_s,
+            result.lookahead,
+            result.fcfs_head_size,
+        )
+        return result
+
+    @staticmethod
+    def eligible(request):
+        return (
+            request.status == RequestStatus.WAITING
+            and request.num_computed_tokens == 0
+            and request.num_preemptions == 0
+            and request.num_output_tokens == 0
+            and request.num_stale_output_tokens == 0
+            and not request.has_encoder_inputs
+            and request.sampling_params is not None
+        )
+
+    def promote(self, scheduler, queue):
+        """Promote one candidate; normal admission checks still run afterward."""
+        if queue is not scheduler.waiting or not queue:
+            return
+        candidates = []
+        for request in islice(queue, self.lookahead):
+            # Do not move a fresh request across an existing special request.
+            if not self.eligible(request):
+                break
+            candidates.append(request)
+        if not candidates:
+            return
+
+        if self.fcfs_head_size:
+            waiting_ids = {request.request_id for request in queue}
+            self._cohort_ids.intersection_update(waiting_ids)
+            self._protected_ids.intersection_update(waiting_ids)
+            if not self._cohort_ids:
+                # A cohort is the waiting snapshot, not a sliding protected head.
+                self._cohort_ids.update(waiting_ids)
+                self._protected_ids.update(
+                    request.request_id
+                    for request in islice(candidates, self.fcfs_head_size)
+                )
+
+        now = time.time()
+        oldest = min(candidates, key=lambda request: request.arrival_time)
+        trace = scheduler._study_trace
+        protected = [
+            request
+            for request in candidates
+            if request.request_id in self._protected_ids
+        ]
+        if protected:
+            selected = protected[0]
+            reason = "protected_fcfs_head"
+            selected_score = None
+        elif now - oldest.arrival_time >= self.max_wait_s:
+            selected = oldest
+            reason = "waiting_time_safeguard"
+            selected_score = None
+        else:
+            kv = scheduler.kv_cache_manager
+            selected = None
+            selected_score = -1
+            for request in candidates:
+                score = 0
+                if kv.prefix_cache_lookup_enabled(request):
+                    # Query the coordinator directly: no touching/pinning,
+                    # admission statistics, or BlockStored events for probes.
+                    _, score, _ = kv.coordinator.find_longest_cache_hit(
+                        request.block_hashes, max(0, request.num_tokens - 1)
+                    )
+                if trace is not None:
+                    trace.emit(
+                        "PREFIX_CANDIDATE",
+                        request,
+                        role="scoring_probe",
+                        cached_tokens=score,
+                        waited_ms=round((now - request.arrival_time) * 1000, 3),
+                    )
+                if (
+                    selected is None
+                    or score > selected_score
+                    or (
+                        score == selected_score
+                        and request.arrival_time < selected.arrival_time
+                    )
+                ):
+                    selected, selected_score = request, score
+            reason = "cached_prefix_then_fcfs"
+
+        original_head = queue.peek_request()
+        if selected is not original_head:
+            queue.remove_request(selected)
+            queue.prepend_request(selected)
+        if trace is not None:
+            trace.emit(
+                "PREFIX_SELECTED",
+                selected,
+                reason=reason,
+                cached_tokens=selected_score,
+                candidates=len(candidates),
+                previous_head=original_head.request_id,
+                reordered=selected is not original_head,
+            )
