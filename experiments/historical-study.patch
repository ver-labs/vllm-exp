@@ -0,0 +1,49 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Opt-in LFU with globally consistent allocation-clock decay."""
+
+import os
+
+from vllm.logger import init_logger
+from vllm.v1.core.study_cache_eviction import StudyLFUEviction
+
+logger = init_logger(__name__)
+
+
+class StudyAgingLFUEviction(StudyLFUEviction):
+    name = "aged_lfu"
+
+    def __init__(self, num_blocks):
+        super().__init__(num_blocks)
+        self.half_life_blocks = int(os.environ.get("STUDY_LFU_HALF_LIFE_BLOCKS", "64"))
+        if self.half_life_blocks < 1:
+            raise ValueError("STUDY_LFU_HALF_LIFE_BLOCKS must be positive")
+        self.allocated_blocks = 0
+        self.epochs = 0
+        self.on_decay = None
+        logger.info(
+            "Study cache eviction: aged_lfu; halve all counts every %s "
+            "physical block allocations; free-queue ties",
+            self.half_life_blocks,
+        )
+
+    def select(self, pool, num_blocks):
+        if num_blocks == 0:
+            return []
+        self.allocated_blocks += num_blocks
+        epoch = self.allocated_blocks // self.half_life_blocks
+        elapsed = epoch - self.epochs
+        if elapsed:
+            before = self.reuse_counts.copy() if self.on_decay is not None else None
+            self.reuse_counts[:] = [count >> elapsed for count in self.reuse_counts]
+            self.epochs = epoch
+            if self.order is not None:
+                self.order.rebuild(pool)
+            if self.on_decay is not None:
+                self.on_decay(
+                    allocated_blocks=self.allocated_blocks,
+                    epoch=epoch,
+                    elapsed_epochs=elapsed,
+                    counts_before=before,
+                    counts_after=self.reuse_counts.copy(),
+                )
+        return super().select(pool, num_blocks)
