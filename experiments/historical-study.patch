+++ b/vllm/v1/core/study_free_order.py
@@ -0,0 +1,82 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Incremental LFU victim ordering with upstream free-queue tie order."""
+
+import heapq
+
+
+class StudyFreeOrder:
+    def __init__(self, policy):
+        self.policy = policy
+        self.positions = {}
+        self.entries = {}
+        self.heap = []
+        self.front = 0
+        self.back = 0
+        self.serial = 0
+        self.initialized = False
+        self.rebuilds = 0
+
+    def key(self, pool, block):
+        cached = block.block_hash is not None
+        return (
+            block.block_id in pool._reuse_watchers,
+            cached,
+            self.policy.reuse_counts[block.block_id] if cached else 0,
+            self.positions[block.block_id],
+        )
+
+    def refresh(self, pool, block):
+        if block.block_id not in self.positions:
+            return
+        self.serial += 1
+        entry = (*self.key(pool, block), self.serial, block.block_id)
+        self.entries[block.block_id] = entry
+        heapq.heappush(self.heap, entry)
+
+    def remove(self, block):
+        self.positions.pop(block.block_id, None)
+        self.entries.pop(block.block_id, None)
+
+    def add(self, pool, blocks, front=False):
+        if not self.initialized:
+            return
+        if front:
+            self.front -= len(blocks)
+            start = self.front
+        else:
+            start = self.back
+            self.back += len(blocks)
+        for index, block in enumerate(blocks):
+            self.positions[block.block_id] = start + index
+            self.refresh(pool, block)
+
+    def rebuild(self, pool):
+        blocks = pool.free_block_queue.get_all_free_blocks()
+        self.positions = {b.block_id: i for i, b in enumerate(blocks)}
+        self.front, self.back = 0, len(blocks)
+        self.entries.clear()
+        self.heap.clear()
+        for block in blocks:
+            self.serial += 1
+            entry = (*self.key(pool, block), self.serial, block.block_id)
+            self.entries[block.block_id] = entry
+            self.heap.append(entry)
+        heapq.heapify(self.heap)
+        self.initialized = True
+        self.rebuilds += 1
+
+    def select(self, pool, num_blocks):
+        if not self.initialized or len(self.heap) > 4 * len(pool.blocks):
+            self.rebuild(pool)
+        selected = []
+        while len(selected) < num_blocks:
+            entry = heapq.heappop(self.heap)
+            block_id = entry[-1]
+            if self.entries.get(block_id) != entry:
+                continue
+            block = pool.blocks[block_id]
+            assert block.ref_cnt == 0 and not block.is_null
+            self.remove(block)
+            pool.free_block_queue.remove(block)
+            selected.append(block)
+        return selected
diff --git a/vllm/v1/core/study_partial_prefix.py b/vllm/v1/core/study_partial_prefix.py
new file mode 100644
index 0000000..ca8dbea
--- /dev/null
+++ b/vllm/v1/core/study_partial_prefix.py
@@ -0,0 +1,123 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Opt-in indexing of computed interior prompt-prefix boundaries."""
+
+import os
+
+from vllm.v1.kv_cache_interface import FullAttentionSpec
+
+
+class StudyPartialPrefix:
+    @classmethod
+    def from_environment(cls, cache_manager):
+        if os.environ.get("STUDY_PARTIAL_PREFIX", "0") != "1":
+            return None
+        managers = cache_manager.coordinator.single_type_managers
+        if (
+            not cache_manager.enable_caching
+            or cache_manager.use_eagle
+            or len(managers) != 1
+            or type(managers[0].kv_cache_spec) is not FullAttentionSpec
+            or managers[0].dcp_world_size != 1
+            or managers[0].pcp_world_size != 1
+            or cache_manager.block_pool.hash_block_size >= managers[0].block_size
+        ):
+            raise ValueError(
+                "Study partial-prefix indexing needs fine-grained, "
+                "single-device, single-group full attention"
+            )
+        minimum = int(os.environ.get("STUDY_PARTIAL_MIN_TOKENS", "0"))
+        if not 0 <= minimum <= managers[0].block_size:
+            raise ValueError("Partial minimum must be between zero and block size")
+        cache_manager.block_pool._study_partial_min_tokens = minimum
+        cache_manager.block_pool._study_partial_prefix_enabled = True
+        return cls(managers[0])
+
+    def __init__(self, manager):
+        self.manager = manager
+        self.progress = {}
+        self.valid = {}
+        self.dirty = {}
+        self.owners = {}
+        self.visited_blocks = 0
+        self.incremental = (
+            os.environ.get("STUDY_CACHE_IMPL", "incremental") == "incremental"
+        )
+        if self.incremental:
+            manager.block_pool._study_partial_index = self
+
+    def publish(self, request):
+        """Called only after this request's model work has completed."""
+        manager = self.manager
+        pool = manager.block_pool
+        unit, size = pool.hash_block_size, manager.block_size
+        valid = min(request.num_computed_tokens, request.num_prompt_tokens)
+        history = self.progress.setdefault(request.request_id, {})
+        blocks = manager.req_to_blocks[request.request_id]
+        if self.incremental:
+            previous_valid = self.valid.get(request.request_id, 0)
+            if valid < previous_valid:
+                self.forget(request.request_id)
+                history = self.progress.setdefault(request.request_id, {})
+                previous_valid = 0
+            indices = self.dirty.pop(request.request_id, set())
+            if valid > previous_valid:
+                indices.update(
+                    range(previous_valid // size, (valid + size - 1) // size)
+                )
+            indices = sorted(i for i in indices if i < len(blocks))
+            self.valid[request.request_id] = valid
+        else:
+            indices = range(len(blocks))
+        for index in indices:
+            self.visited_blocks += 1
+            block = blocks[index]
+            start = index * size
+            end = min(valid, start + size - unit)
+            if end <= start:
+                break
+            signature = (block.block_id, block.block_hash)
+            previous, boundary = history.get(index, (None, start))
+            if self.incremental:
+                owner = (request.request_id, index)
+                if previous is not None and previous[0] != block.block_id:
+                    self.owners[previous[0]].discard(owner)
+                    if not self.owners[previous[0]]:
+                        del self.owners[previous[0]]
+                self.owners.setdefault(block.block_id, set()).add(owner)
+            if previous != signature:
+                boundary = start
+            if not block.is_null:
+                for position in range(boundary + unit, end + 1, unit):
+                    pool.cache_partial_block(
+                        request,
+                        block,
+                        position,
+                        manager.kv_cache_group_id,
+                        size,
+                        preserve_existing_hashes=True,
+                    )
+                history[index] = (
+                    (block.block_id, block.block_hash),
+                    end // unit * unit,
+                )
+
+    def block_changed(self, block_id):
+        for request_id, index in self.owners.get(block_id, ()):
+            self.dirty.setdefault(request_id, set()).add(index)
+
+    def forget(self, request_id):
+        for index, (signature, _) in self.progress.pop(request_id, {}).items():
+            if self.incremental:
+                owners = self.owners.get(signature[0])
+                if owners is not None:
+                    owners.discard((request_id, index))
+                    if not owners:
+                        del self.owners[signature[0]]
+        self.valid.pop(request_id, None)
+        self.dirty.pop(request_id, None)
+
+    def reset(self):
+        self.progress.clear()
+        self.valid.clear()
+        self.dirty.clear()
+        self.owners.clear()
diff --git a/vllm/v1/core/study_queue_eviction.py b/vllm/v1/core/study_queue_eviction.py
new file mode 100644
index 0000000..c42d71c
--- /dev/null
+++ b/vllm/v1/core/study_queue_eviction.py
@@ -0,0 +1,124 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Opt-in soft retention of exact prefixes demanded by the waiting queue."""
+
+import os
+import time
+from collections import Counter
+from itertools import islice
+
+from vllm.logger import init_logger
+from vllm.v1.core.sched.request_queue import SchedulingPolicy
+from vllm.v1.core.sched.study_prefix_policy import PrefixAwareWaitingPolicy
+from vllm.v1.core.study_cache_eviction import StudyLFUEviction
+from vllm.v1.kv_cache_interface import FullAttentionSpec
+
+logger = init_logger(__name__)
+
+
+class StudyQueueEviction(StudyLFUEviction):
+    name = "queue"
+
+    def __init__(self, num_blocks):
+        super().__init__(num_blocks)
+        self.lookahead = int(os.environ.get("STUDY_QUEUE_LOOKAHEAD", "16"))
+        if self.lookahead < 1:
+            raise ValueError("STUDY_QUEUE_LOOKAHEAD must be positive")
+        self.scheduler = None
+
+    def bind(self, scheduler):
+        groups = scheduler.kv_cache_config.kv_cache_groups
+        kv = scheduler.kv_cache_manager
+        if (
+            scheduler.policy != SchedulingPolicy.FCFS
+            or scheduler.scheduler_config.async_scheduling
+            or scheduler.connector is not None
+            or scheduler.lora_config is not None
+            or scheduler.vllm_config.speculative_config is not None
+            or scheduler._study_prefix_policy is not None
+            or scheduler._study_skip_continue is not None
+            or kv._study_partial_prefix is not None
+            or len(groups) != 1
+            or type(groups[0].kv_cache_spec) is not FullAttentionSpec
+            or kv.coordinator.dcp_world_size != 1
+            or kv.coordinator.pcp_world_size != 1
+        ):
+            raise ValueError(
+                "Queue retention needs synchronous FCFS, one full-attention "
+                "group, no connector/LoRA/speculation or other study policies"
+            )
+        self.scheduler = scheduler
+        logger.info(
+            "Study cache eviction: queue; lookahead=%s; soft zero-ref "
+            "retention; free-queue ties; admission remains FCFS",
+            self.lookahead,
+        )
+
+    def collect_demand(self):
+        """Read current contiguous hits without touching or pinning blocks."""
+        if self.scheduler is None:
+            raise RuntimeError("Queue retention has not been bound to the scheduler")
+        kv = self.scheduler.kv_cache_manager
+        demand = Counter()
+        probes = []
+        for request in islice(self.scheduler.waiting, self.lookahead):
+            if not PrefixAwareWaitingPolicy.eligible(request):
+                continue
+            if not kv.prefix_cache_lookup_enabled(request):
+                continue
+            groups, tokens, _ = kv.coordinator.find_longest_cache_hit(
+                request.block_hashes, max(0, request.num_tokens - 1)
+            )
+            ids = {
+                block.block_id
+                for block in groups[0]
+                if not block.is_null and block.ref_cnt == 0
+            }
+            demand.update(ids)
+            probes.append((request.request_id, tokens, sorted(ids)))
+        return demand, probes
+
+    def select(self, pool, num_blocks):
+        if num_blocks == 0:
+            return []
+        trace = getattr(self.scheduler, "_study_trace", None)
+        started = time.perf_counter_ns() if trace is not None else None
+        # Refresh at allocation, so admissions, frees and evictions cannot leave
+        # stale page identities in a retained snapshot.
+        demand, probes = self.collect_demand()
+        candidates = pool.free_block_queue.get_all_free_blocks()
+        buckets = [[[] for _ in range(self.lookahead + 1)] for _ in range(2)]
+        for block in candidates:
+            watcher = int(block.block_id in pool._reuse_watchers)
+            buckets[watcher][demand[block.block_id]].append(block)
+        selected = []
+        for watcher_buckets in buckets:
+            for bucket in watcher_buckets:
+                selected.extend(bucket[: num_blocks - len(selected)])
+                if len(selected) == num_blocks:
+                    break
+            if len(selected) == num_blocks:
+                break
+        assert len(selected) == num_blocks
+        for block in selected:
+            assert block.ref_cnt == 0 and not block.is_null
+            pool.free_block_queue.remove(block)
+        if trace is not None:
+            selected_ids = {block.block_id for block in selected}
+            trace.emit(
+                "QUEUE_CACHE_RETENTION",
+                lookahead=self.lookahead,
+                probes=[
+                    dict(request_id=r, hit_tokens=t, free_hit_blocks=b)
+                    for r, t, b in probes
+                ],
+                demand=dict(demand),
+                selected_blocks=[block.block_id for block in selected],
+                selected_demanded=sum(block.block_id in demand for block in selected),
+                retained_instead_of_upstream=[
+                    block.block_id
+                    for block in candidates[:num_blocks]
+                    if block.block_id in demand and block.block_id not in selected_ids
+                ],
+                selection_ns=time.perf_counter_ns() - started,
+            )
+        return selected
