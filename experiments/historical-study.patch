+def _study_lfu_pool(policy):
+    import os
+    from unittest.mock import patch
+
+    from vllm.v1.core.block_pool import BlockPool
+
+    with patch.dict(os.environ, {"STUDY_EVICTION_POLICY": policy}):
+        return BlockPool(4, True, 16)
+
+
+def test_study_lfu_preserves_hot_free_block_and_resets_reassigned_count():
+    pool = _study_lfu_pool("lfu")
+    hot, cold, active = pool.get_new_blocks(3)
+    for block, key in [(hot, b"hot"), (cold, b"cold")]:
+        block.set_block_hash(key)
+        pool.cached_block_hash_to_block.insert(key, block)
+    for _ in range(3):
+        pool.touch([hot])
+        pool.free_blocks([hot])
+    pool.free_blocks([hot, cold])
+    assert hot.ref_cnt == cold.ref_cnt == 0 and active.ref_cnt == 1
+    assert pool.get_new_blocks(1) == [cold]
+    assert hot.block_hash == b"hot" and hot.ref_cnt == 0
+    assert pool._study_eviction.reuse_counts[hot.block_id] == 3
+    assert pool._study_eviction.reuse_counts[cold.block_id] == 0
+    # Preservation is a preference, not pinning: hot remains allocatable.
+    assert pool.get_new_blocks(1) == [hot]
+    assert pool._study_eviction.reuse_counts[hot.block_id] == 0
+    assert pool.get_num_free_blocks() == 0
+
+
+def test_study_lfu_uncached_first_stable_ties_and_cache_reset():
+    pool = _study_lfu_pool("lfu")
+    first, second, uncached = pool.get_new_blocks(3)
+    for block in (first, second):
+        key = str(block.block_id).encode()
+        block.set_block_hash(key)
+        pool.cached_block_hash_to_block.insert(key, block)
+    pool.free_blocks([first, second, uncached])
+    assert pool.get_new_blocks(3) == [uncached, first, second]
+    pool.free_blocks([uncached, first, second])
+    assert pool.reset_prefix_cache()
+    assert pool._study_eviction.reuse_counts == [0, 0, 0, 0]
+    assert pool.get_new_blocks(0) == []
+
+
+def test_study_lfu_keeps_deferred_readers_last_resort():
+    pool = _study_lfu_pool("lfu")
+    reader, cached, active = pool.get_new_blocks(3)
+    cached.set_block_hash(b"cached")
+    pool.cached_block_hash_to_block.insert(b"cached", cached)
+    seen = []
+    pool.unpin_blocks([reader], on_reuse=lambda block: seen.append(block.block_id))
+    pool.free_blocks([cached])
+    assert pool.get_new_blocks(1) == [cached]
+    assert seen == []
+    assert pool.get_new_blocks(1) == [reader]
+    assert seen == [reader.block_id] and active.ref_cnt == 1
+
+
+def test_study_lfu_default_keeps_upstream_eviction_order():
+    pool = _study_lfu_pool("vllm")
+    assert pool._study_eviction is None
+    first, second, active = pool.get_new_blocks(3)
+    for block in (first, second):
+        key = str(block.block_id).encode()
+        block.set_block_hash(key)
+        pool.cached_block_hash_to_block.insert(key, block)
+    for _ in range(3):
+        pool.touch([first])
+        pool.free_blocks([first])
+    pool.free_blocks([first, second])
+    assert pool.get_new_blocks(1) == [first]
+    assert active.ref_cnt == 1
