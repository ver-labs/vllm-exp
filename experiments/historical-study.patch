@@ -0,0 +1,80 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Opt-in LFU comparison for the local prefix-cache eviction study."""
+
+from __future__ import annotations
+
+import os
+from typing import TYPE_CHECKING
+
+from vllm.logger import init_logger
+from vllm.v1.core.study_free_order import StudyFreeOrder
+
+if TYPE_CHECKING:
+    from vllm.v1.core.block_pool import BlockPool
+
+logger = init_logger(__name__)
+
+
+class StudyLFUEviction:
+    name = "lfu"
+
+    def __init__(self, num_blocks: int):
+        self.reuse_counts = [0] * num_blocks
+        self.order = (
+            StudyFreeOrder(self)
+            if os.environ.get("STUDY_CACHE_IMPL", "incremental") == "incremental"
+            and self.name in ("lfu", "aged_lfu")
+            else None
+        )
+
+    @classmethod
+    def from_environment(cls, num_blocks: int, enable_caching: bool):
+        policy = os.environ.get("STUDY_EVICTION_POLICY", "vllm")
+        if policy == "vllm":
+            return None
+        if policy == "aged_lfu":
+            if not enable_caching:
+                raise ValueError("Aging LFU requires prefix caching")
+            from vllm.v1.core.study_aging_eviction import StudyAgingLFUEviction
+
+            return StudyAgingLFUEviction(num_blocks)
+        if policy == "queue":
+            if not enable_caching:
+                raise ValueError("Queue retention requires prefix caching")
+            from vllm.v1.core.study_queue_eviction import StudyQueueEviction
+
+            return StudyQueueEviction(num_blocks)
+        if policy != "lfu":
+            raise ValueError(
+                "STUDY_EVICTION_POLICY must be vllm, lfu, aged_lfu, or queue"
+            )
+        if not enable_caching:
+            raise ValueError("Study LFU eviction requires prefix caching")
+        logger.info(
+            "Study cache eviction: lfu; uncached first, then least reused; "
+            "free-queue-order ties; counts reset on reassignment; no aging"
+        )
+        return cls(num_blocks)
+
+    def select(self, pool: BlockPool, num_blocks: int):
+        if num_blocks == 0:
+            return []
+        if self.order is not None:
+            return self.order.select(pool, num_blocks)
+        # Stable sorting retains upstream eviction order for equal scores.
+        # Deferred-reader blocks retain their upstream last-resort priority.
+        candidates = pool.free_block_queue.get_all_free_blocks()
+        candidates.sort(
+            key=lambda block: (
+                block.block_id in pool._reuse_watchers,
+                block.block_hash is not None,
+                self.reuse_counts[block.block_id]
+                if block.block_hash is not None
+                else 0,
+            )
+        )
+        selected = candidates[:num_blocks]
+        for block in selected:
+            assert block.ref_cnt == 0 and not block.is_null
+            pool.free_block_queue.remove(block)
+        return selected
