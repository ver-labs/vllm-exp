+# SPDX-License-Identifier: Apache-2.0
+"""Opt-in aggregate CPU timings; no per-step serialization."""
+
+import functools
+import json
+import os
+import queue
+import threading
+import time
+from pathlib import Path
+
+
+def install(scheduler):
+    if os.environ.get("STUDY_CACHE_PROFILE") != "1":
+        return
+    totals = {}
+    pool = scheduler.kv_cache_manager.block_pool
+    partial = scheduler.kv_cache_manager._study_partial_prefix
+    snapshots = queue.SimpleQueue()
+    idle_updates = 0
+
+    def writer():
+        path = Path(os.environ["VLLM_STUDY_TRACE_DIR"]) / "cpu-profile.json"
+        while True:
+            snapshot = snapshots.get()
+            temporary = path.with_suffix(".tmp")
+            temporary.write_text(json.dumps(snapshot, indent=2) + "\n")
+            temporary.replace(path)
+
+    threading.Thread(target=writer, daemon=True).start()
+
+    def snapshot():
+        order = getattr(pool._study_eviction, "order", None)
+        snapshots.put(
+            dict(
+                implementation=os.environ.get("STUDY_CACHE_IMPL", "incremental"),
+                timings={key: value.copy() for key, value in totals.items()},
+                partial_blocks_visited=getattr(partial, "visited_blocks", 0),
+                order_rebuilds=getattr(order, "rebuilds", 0),
+                idle_updates=idle_updates,
+                includes_warmup=True,
+                clock="perf_counter_ns (host elapsed, no GPU synchronization)",
+            )
+        )
+
+    def wrap(obj, name, label):
+        original = getattr(obj, name)
+        totals[label] = dict(calls=0, ns=0)
+
+        @functools.wraps(original)
+        def timed(*args, **kwargs):
+            nonlocal idle_updates
+            started = time.perf_counter_ns()
+            try:
+                return original(*args, **kwargs)
+            finally:
+                totals[label]["ns"] += time.perf_counter_ns() - started
+                totals[label]["calls"] += 1
+                if (
+                    label == "update_from_output"
+                    and not scheduler.running
+                    and not scheduler.waiting
+                ):
+                    idle_updates += 1
+                    snapshot()
+
+        setattr(obj, name, timed)
+
+    wrap(scheduler, "_free_request", "request_finish")
+    wrap(scheduler, "schedule", "schedule")
+    wrap(scheduler, "update_from_output", "update_from_output")
+    if partial is not None:
+        wrap(partial, "publish", "partial_publish")
+    if pool._study_eviction is not None:
+        wrap(pool._study_eviction, "select", "eviction_select")
