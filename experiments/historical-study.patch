--- /dev/null
+++ b/vllm/v1/core/sched/study_adaptive_prefill.py
@@ -0,0 +1,38 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Opt-in decoding-load prefill cap for the local study."""
+
+import os
+from itertools import chain
+
+
+class StudyAdaptivePrefill:
+    @classmethod
+    def from_environment(cls, scheduler):
+        if os.environ.get("STUDY_ADAPTIVE_PREFILL") != "1":
+            return None
+        if not scheduler.scheduler_config.enable_chunked_prefill:
+            raise ValueError("Adaptive prefill requires chunked prefill")
+        if scheduler._study_skip_continue is not None:
+            raise ValueError("Adaptive prefill requires skip/continue disabled")
+        if scheduler.adaptive_long_prefill_threshold:
+            raise ValueError("Choose either study or existing adaptive prefill")
+        return cls()
+
+    def choose(self, running, waiting, budget, now):
+        decoders = sum(
+            r.num_output_tokens > 0 and r.num_computed_tokens >= r.num_prompt_tokens
+            for r in running
+        )
+        oldest_age = max(
+            (
+                max(0.0, now - r.arrival_time)
+                for r in chain(running, waiting)
+                if r.num_computed_tokens < r.num_prompt_tokens
+            ),
+            default=0.0,
+        )
+        cap = max(16, budget // (1 + 2 * decoders))
+        age_boost = oldest_age >= 0.75
+        if age_boost:
+            cap = max(cap, 64)
+        return min(budget, cap), decoders, oldest_age, age_boost
