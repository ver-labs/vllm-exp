diff --git a/vllm/v1/core/sched/study_skip_continue.py b/vllm/v1/core/sched/study_skip_continue.py
new file mode 100644
index 0000000..ba2fb67
--- /dev/null
+++ b/vllm/v1/core/sched/study_skip_continue.py
@@ -0,0 +1,88 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Bounded, opt-in backfill around an oversized unchunked waiting prompt."""
+
+import math
+import os
+import time
+from weakref import WeakKeyDictionary
+
+from vllm.v1.core.sched.request_queue import SchedulingPolicy
+from vllm.v1.request import RequestStatus
+
+
+class StudySkipContinue:
+    @classmethod
+    def from_environment(cls, scheduler):
+        if os.environ.get("STUDY_SKIP_CONTINUE", "0") != "1":
+            return None
+        if (
+            scheduler.policy != SchedulingPolicy.FCFS
+            or scheduler.scheduler_config.enable_chunked_prefill
+            or scheduler.scheduler_config.async_scheduling
+            or scheduler.scheduler_config.long_prefill_token_threshold
+            or scheduler.connector is not None
+            or scheduler.lora_config is not None
+            or scheduler.vllm_config.speculative_config is not None
+            or scheduler.is_encoder_decoder
+            or scheduler._study_prefix_policy is not None
+        ):
+            raise ValueError(
+                "Study skip/continue requires plain synchronous unchunked FCFS"
+            )
+        return cls(
+            int(os.environ.get("STUDY_SKIP_LOOKAHEAD", "16")),
+            int(os.environ.get("STUDY_SKIP_MAX_BYPASSES", "4")),
+            float(os.environ.get("STUDY_SKIP_MAX_WAIT_S", "30")),
+        )
+
+    def __init__(self, lookahead=16, max_bypasses=4, max_wait_s=30):
+        if (
+            lookahead < 1
+            or max_bypasses < 1
+            or not math.isfinite(max_wait_s)
+            or max_wait_s <= 0
+        ):
+            raise ValueError("Study skip limits must be finite and positive")
+        self.lookahead, self.max_bypasses, self.max_wait_s = (
+            lookahead,
+            max_bypasses,
+            max_wait_s,
+        )
+        self.bypasses = WeakKeyDictionary()
+        self.begin_step()
+
+    def begin_step(self):
+        self.scanning = False
+        self.examined = 0
+
+    def scan_allowed(self):
+        return not self.scanning or self.examined < self.lookahead
+
+    def considered(self):
+        if self.scanning:
+            self.examined += 1
+
+    def can_skip(self, request, *, ordinary_waiting, now=None):
+        now = time.time() if now is None else now
+        eligible = (
+            ordinary_waiting
+            and request.status == RequestStatus.WAITING
+            and request.num_computed_tokens == 0
+            and request.num_preemptions == 0
+            and request.num_output_tokens == 0
+            and request.num_stale_output_tokens == 0
+            and not request.has_encoder_inputs
+        )
+        if (
+            not eligible
+            or self.bypasses.get(request, 0) >= self.max_bypasses
+            or now - request.arrival_time >= self.max_wait_s
+        ):
+            return False
+        if not self.scanning:
+            self.scanning, self.examined = True, 1
+        self.bypasses[request] = self.bypasses.get(request, 0) + 1
+        return True
+
+    def admitted(self, request):
+        self.bypasses.pop(request, None)
