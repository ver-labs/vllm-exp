+# SPDX-License-Identifier: Apache-2.0
+"""Opt-in indexing of computed interior prompt-prefix boundaries."""
+
+import os
+
+from vllm.v1.kv_cache_interface import FullAttentionSpec
+
+
+class StudyPartialPrefix:
+    @classmethod
+    def from_environment(cls, cache_manager):
+        if os.environ.get("STUDY_PARTIAL_PREFIX", "0") != "1":
+            return None
+        managers = cache_manager.coordinator.single_type_managers
+        if (
+            not cache_manager.enable_caching
+            or cache_manager.use_eagle
+            or len(managers) != 1
+            or type(managers[0].kv_cache_spec) is not FullAttentionSpec
+            or managers[0].dcp_world_size != 1
+            or managers[0].pcp_world_size != 1
+            or cache_manager.block_pool.hash_block_size >= managers[0].block_size
+        ):
+            raise ValueError(
+                "Study partial-prefix indexing needs fine-grained, "
+                "single-device, single-group full attention"
+            )
+        minimum = int(os.environ.get("STUDY_PARTIAL_MIN_TOKENS", "0"))
+        if not 0 <= minimum <= managers[0].block_size:
+            raise ValueError("Partial minimum must be between zero and block size")
+        cache_manager.block_pool._study_partial_min_tokens = minimum
+        cache_manager.block_pool._study_partial_prefix_enabled = True
+        return cls(managers[0])
+
+    def __init__(self, manager):
+        self.manager = manager
+        self.progress = {}
+        self.valid = {}
+        self.dirty = {}
+        self.owners = {}
+        self.visited_blocks = 0
+        self.incremental = (
+            os.environ.get("STUDY_CACHE_IMPL", "incremental") == "incremental"
+        )
+        if self.incremental:
+            manager.block_pool._study_partial_index = self
+
+    def publish(self, request):
+        """Called only after this request's model work has completed."""
+        manager = self.manager
+        pool = manager.block_pool
+        unit, size = pool.hash_block_size, manager.block_size
+        valid = min(request.num_computed_tokens, request.num_prompt_tokens)
+        history = self.progress.setdefault(request.request_id, {})
+        blocks = manager.req_to_blocks[request.request_id]
+        if self.incremental:
+            previous_valid = self.valid.get(request.request_id, 0)
+            if valid < previous_valid:
+                self.forget(request.request_id)
+                history = self.progress.setdefault(request.request_id, {})
+                previous_valid = 0
+            indices = self.dirty.pop(request.request_id, set())
+            if valid > previous_valid:
+                indices.update(
+                    range(previous_valid // size, (valid + size - 1) // size)
+                )
+            indices = sorted(i for i in indices if i < len(blocks))
+            self.valid[request.request_id] = valid
+        else:
+            indices = range(len(blocks))
+        for index in indices:
+            self.visited_blocks += 1
+            block = blocks[index]
+            start = index * size
+            end = min(valid, start + size - unit)
+            if end <= start:
+                break
+            signature = (block.block_id, block.block_hash)
+            previous, boundary = history.get(index, (None, start))
+            if self.incremental:
+                owner = (request.request_id, index)
+                if previous is not None and previous[0] != block.block_id:
+                    self.owners[previous[0]].discard(owner)
+                    if not self.owners[previous[0]]:
+                        del self.owners[previous[0]]
+                self.owners.setdefault(block.block_id, set()).add(owner)
+            if previous != signature:
+                boundary = start
+            if not block.is_null:
+                for position in range(boundary + unit, end + 1, unit):
+                    pool.cache_partial_block(
+                        request,
+                        block,
+                        position,
+                        manager.kv_cache_group_id,
+                        size,
+                        preserve_existing_hashes=True,
+                    )
+                history[index] = (
+                    (block.block_id, block.block_hash),
+                    end // unit * unit,
+                )
+
+    def block_changed(self, block_id):
+        for request_id, index in self.owners.get(block_id, ()):
+            self.dirty.setdefault(request_id, set()).add(index)
+
+    def forget(self, request_id):
+        for index, (signature, _) in self.progress.pop(request_id, {}).items():
+            if self.incremental:
+                owners = self.owners.get(signature[0])
+                if owners is not None:
+                    owners.discard((request_id, index))
+                    if not owners:
+                        del self.owners[signature[0]]
+        self.valid.pop(request_id, None)
+        self.dirty.pop(request_id, None)
+
+    def reset(self):
+        self.visited_blocks = 0
+        self.progress.clear()
+        self.valid.clear()
+        self.dirty.clear()
+        self.owners.clear()
